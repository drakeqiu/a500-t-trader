#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "Running Markdown lint on staged files..."
git diff --cached --name-only --diff-filter=ACMR -z -- '*.md' |
    xargs -0 -r npx --yes markdownlint-cli2

echo "Running Markdown and JSON format checks on staged files..."
git diff --cached --name-only --diff-filter=ACMR -z -- '*.md' '*.json' |
    xargs -0 -r npx --yes prettier --check

echo "Running Ruff lint..."
uv run --no-sync ruff check .

echo "Running Ruff format check..."
uv run --no-sync ruff format --check .

echo "Running mypy..."
uv run --no-sync mypy

echo "Running mypy fixture script bodies..."
uv run --no-sync mypy scripts/frontend-api-mock.py
echo "Running frontend lint..."
(cd "$repo_root/frontend" && bun run lint)

echo "Running frontend format check..."
(cd "$repo_root/frontend" && bun run format:check)

echo "Running frontend unit tests..."
(cd "$repo_root/frontend" && bun run test)
